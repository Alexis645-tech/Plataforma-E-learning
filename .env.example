# ==============================================================================
# EDUSPHERE LMS - PLANTILLA DE VARIABLES DE ENTORNO (.env.example)
# ==============================================================================
# AVISO DE SEGURIDAD:
# Este archivo es únicamente un ejemplo y plantilla pública.
# NUNCA agregues contraseñas reales ni cadenas de conexión con credenciales aquí.
# Para producción:
# 1. Copia este archivo a un nuevo archivo llamado '.env' en tu entorno local.
# 2. El archivo '.env' está protegido en el '.gitignore' para no subirse a GitHub.
# 3. En Vercel: Configura estas variables en "Settings" -> "Environment Variables".
# ==============================================================================

# GEMINI_API_KEY: Requerida para las funciones de IA con Google Gemini
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: URL base de la aplicación (proporcionada por el host o localhost:3000)
APP_URL="MY_APP_URL"

# MONGODB_URI: Cadena de conexión cifrada hacia tu clúster de MongoDB Atlas o base local
# Las contraseñas de los usuarios se almacenan con hash criptográfico unidireccional (bcrypt, salt rounds = 10)
# Ejemplo: mongodb+srv://<db_user>:<db_password>@cluster0.xxxx.mongodb.net/edusphere?retryWrites=true&w=majority
MONGODB_URI="mongodb+srv://<usuario>:<password>@cluster0.abcde.mongodb.net/edusphere?retryWrites=true&w=majority"

# BCRYPT_SALT_ROUNDS: Rondas de sal para el cifrado y hashing de contraseñas (por defecto: 10)
BCRYPT_SALT_ROUNDS="10"
